generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  FUNCIONARIO
  /// Conta do tablet fixo na loja: so abre a tela de quiosque, onde os
  /// funcionarios sao identificados pelo rosto. Nao ve relatorios nem cadastros.
  TOTEM
}

enum TipoRegistro {
  ENTRADA
  INICIO_INTERVALO
  FIM_INTERVALO
  SAIDA
}

enum OrigemRegistro {
  FACIAL // batido pelo proprio funcionario, logado, com validacao facial
  TOTEM  // batido no tablet da loja, com o funcionario identificado pelo rosto
  MANUAL // lancado diretamente por um administrador
  AJUSTE // criado pela aprovacao de uma solicitacao de ajuste
}

enum StatusSolicitacao {
  PENDENTE
  /// Ajuste proposto pelo administrador, esperando o funcionario confirmar no
  /// proximo registro. So vira APROVADA depois do de-acordo dele.
  AGUARDANDO_FUNCIONARIO
  APROVADA
  REJEITADA
}

enum AcaoSolicitacao {
  INCLUIR
  ALTERAR
  EXCLUIR
}

enum TipoAusencia {
  FERIAS
  FOLGA
  ATESTADO
  LICENCA
  OUTRO
}

enum StatusAusencia {
  /// Agendada pelo administrador, ainda sem efeito sobre a jornada.
  AGENDADA
  /// Validada: os dias do periodo deixam de cobrar jornada.
  VALIDADA
  CANCELADA
}

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  /// Nulo quando o funcionario nao tem acesso proprio (bate ponto so pelo totem).
  email     String? @unique
  matricula String  @unique
  /// Nulo quando o funcionario nao tem acesso proprio. Sem hash, nao ha login.
  senhaHash String?
  papel     Papel   @default(FUNCIONARIO)
  ativo     Boolean @default(true)

  cargo        String?
  departamento String?

  /// Precisa trocar a senha no proximo login (senha provisoria do admin).
  trocarSenha Boolean @default(true)

  /// Momento em que o funcionario aceitou o termo de uso de imagem/biometria
  /// facial (LGPD). Nulo ate o aceite; bloqueia o acesso enquanto nao preenchido.
  /// Aplica-se apenas a quem tem papel FUNCIONARIO.
  termoAceiteEm DateTime?

  // ---- Jornada de trabalho ----
  /// Data de admissao (YYYY-MM-DD no fuso da empresa). Antes dela o funcionario
  /// nao devia jornada nenhuma, entao o relatorio nao cobra falta desses dias.
  /// Nulo mantem o comportamento antigo: cobra o periodo inteiro pedido.
  admissaoEm String?
  /// Padrao da jornada, usado nos dias da semana sem horario proprio em
  /// HorarioDia. Continua valendo sozinho para quem foi cadastrado antes de
  /// existir horario por dia.
  /// Minutos de trabalho previstos por dia (ex.: 480 = 8h).
  cargaDiariaMinutos Int    @default(480)
  /// Horario previsto de entrada no formato HH:mm.
  entradaPrevista    String @default("08:00")
  /// Horario previsto de saida no formato HH:mm.
  saidaPrevista      String @default("17:00")
  /// Minutos previstos de intervalo (almoco).
  intervaloMinutos   Int    @default(60)
  /// Dias da semana trabalhados (0=domingo ... 6=sabado).
  diasSemana         Int[]  @default([1, 2, 3, 4, 5])

  ultimoLogin DateTime?
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt

  biometrias    Biometria[]
  horarios      HorarioDia[]
  registros     Registro[]      @relation("RegistrosDoUsuario")
  registrosFeitos Registro[]    @relation("RegistrosLancadosPor")
  solicitacoes  Solicitacao[]   @relation("SolicitacoesDoUsuario")
  revisoes      Solicitacao[]   @relation("SolicitacoesRevisadasPor")
  propostas     Solicitacao[]   @relation("SolicitacoesPropostasPor")
  ausencias         Ausencia[]  @relation("AusenciasDoUsuario")
  ausenciasCriadas  Ausencia[]  @relation("AusenciasCriadasPor")
  ausenciasValidadas Ausencia[] @relation("AusenciasValidadasPor")
  auditoria     Auditoria[]

  @@index([papel, ativo])
}

/// Jornada de um dia da semana especifico. Existe para a loja que abre em
/// horario diferente no sabado: sem isso, um unico par entrada/saida teria de
/// servir para a semana toda. A ausencia de linha para um dia significa "usa o
/// padrao do Usuario", o que mantem funcionando quem foi cadastrado antes.
model HorarioDia {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// 0=domingo ... 6=sabado
  diaSemana Int
  /// Falso marca folga: o dia nao cobra jornada.
  trabalha  Boolean @default(true)
  entrada   String  @default("08:00")
  saida     String  @default("17:00")
  intervaloMinutos Int @default(60)
  /// Minutos previstos no dia. Normalmente saida - entrada - intervalo, mas
  /// fica editavel porque a jornada contratada nem sempre bate com o relogio.
  cargaMinutos Int  @default(480)

  @@unique([usuarioId, diaSemana])
  @@index([usuarioId])
}

/// Periodo sem expediente combinado com antecedencia (ferias, folga, atestado).
/// Depois de VALIDADA, os dias do intervalo param de cobrar jornada e deixam de
/// contar como falta ou ponto pendente.
model Ausencia {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation("AusenciasDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo   TipoAusencia   @default(FERIAS)
  /// Competencias YYYY-MM-DD, inclusive nas duas pontas.
  inicio String
  fim    String
  status StatusAusencia @default(AGENDADA)

  observacao String? @db.Text

  criadoPorId String?
  criadoPor   Usuario? @relation("AusenciasCriadasPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  validadoPorId String?
  validadoPor   Usuario? @relation("AusenciasValidadasPor", fields: [validadoPorId], references: [id], onDelete: SetNull)
  validadoEm    DateTime?

  criadoEm DateTime @default(now())

  @@index([usuarioId, inicio, fim])
  @@index([status])
}

/// Assinatura facial (descriptor de 128 dimensoes gerado pelo face-api no navegador).
/// A imagem original nunca e persistida aqui: guardamos apenas o vetor.
model Biometria {
  id         String  @id @default(cuid())
  usuarioId  String
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// 128 numeros float serializados como JSON.
  descriptor Json
  /// Miniatura JPEG capturada no cadastro, para conferencia visual do admin.
  fotoBase64 String? @db.Text
  criadoEm   DateTime @default(now())

  @@index([usuarioId])
}

model Registro {
  id        String       @id @default(cuid())
  usuarioId String
  usuario   Usuario      @relation("RegistrosDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoRegistro
  /// Momento do registro (UTC).
  momento   DateTime
  /// Dia de competencia no formato YYYY-MM-DD (fuso da empresa), usado para agrupar a jornada.
  dia       String
  origem    OrigemRegistro @default(FACIAL)

  // ---- Validacao facial ----
  /// Distancia euclidiana entre o rosto capturado e a biometria cadastrada (menor = melhor).
  faceDistancia Float?
  fotoBase64    String? @db.Text

  // ---- Geolocalizacao ----
  latitude       Float?
  longitude      Float?
  precisaoMetros Float?
  distanciaMetros Float?
  dentroDaCerca  Boolean?

  observacao   String?
  ip           String?
  userAgent    String?
  lancadoPorId String?
  lancadoPor   Usuario? @relation("RegistrosLancadosPor", fields: [lancadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  @@index([usuarioId, dia])
  @@index([dia])
  @@index([momento])
}

model Solicitacao {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation("SolicitacoesDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  acao AcaoSolicitacao @default(INCLUIR)
  /// Dia de competencia (YYYY-MM-DD).
  dia  String
  tipo TipoRegistro
  /// Horario pedido no formato HH:mm (nulo quando a acao e EXCLUIR).
  horario String?
  /// Registro alvo quando a acao e ALTERAR ou EXCLUIR.
  registroAlvoId String?

  motivo String @db.Text
  status StatusSolicitacao @default(PENDENTE)

  /// Preenchido quando quem propos o ajuste foi o administrador. Nesse caminho
  /// a solicitacao nasce AGUARDANDO_FUNCIONARIO e o funcionario da o de-acordo
  /// no proximo registro — o desconto de horas nunca entra as escondidas.
  propostaPorId String?
  propostaPor   Usuario? @relation("SolicitacoesPropostasPor", fields: [propostaPorId], references: [id], onDelete: SetNull)

  respostaAdmin String?   @db.Text
  revisadoPorId String?
  revisadoPor   Usuario?  @relation("SolicitacoesRevisadasPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoEm    DateTime?

  criadoEm DateTime @default(now())

  @@index([status])
  @@index([usuarioId, dia])
  @@index([usuarioId, status])
}

/// Parametros globais da empresa (linha unica, id = "default").
model Config {
  id          String @id @default("default")
  nomeEmpresa String @default("Minha Empresa")
  /// Fuso horario IANA usado para calcular o dia de competencia e exibir horarios.
  fusoHorario String @default("America/Sao_Paulo")

  // ---- Cerca virtual ----
  geofenceAtiva   Boolean @default(false)
  /// Bloqueia o registro fora do raio (quando falso, apenas sinaliza para o admin).
  geofenceBloqueia Boolean @default(false)
  latitude        Float?
  longitude       Float?
  raioMetros      Int     @default(200)

  // ---- Biometria facial ----
  /// Distancia maxima aceita entre o rosto capturado e a biometria (0.4 rigido, 0.6 tolerante).
  /// Usado na conferencia 1:1, quando o sistema ja sabe quem e a pessoa.
  limiarFacial   Float   @default(0.5)

  // ---- Identificacao no totem (1:N) ----
  /// Descobrir quem e a pessoa entre todos os funcionarios erra mais do que
  /// confirmar uma pessoa conhecida, entao o limite aqui e mais rigoroso.
  limiarTotem    Float   @default(0.45)
  /// Distancia minima entre o melhor e o segundo melhor candidato. Se dois
  /// funcionarios ficarem parecidos demais, o totem pede a matricula em vez de
  /// arriscar bater o ponto na pessoa errada.
  margemTotem    Float   @default(0.06)
  /// Guardar a selfie do registro como comprovante para o admin.
  salvarFoto     Boolean @default(true)
  /// Intervalo minimo entre dois registros do mesmo funcionario, em minutos.
  intervaloMinimoMinutos Int @default(1)

  // ---- Jornada ----
  /// Tolerancia em minutos para atraso/saida antecipada.
  toleranciaMinutos Int @default(10)

  atualizadoEm DateTime @updatedAt @default(now())
}

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao      String
  detalhe   String?  @db.Text
  ip        String?
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
}
