# Postgres (Supabase, Neon, Railway ou local)
DATABASE_URL="postgresql://usuario:senha@host:5432/ponto?schema=public"

# Chave usada para assinar o cookie de sessao (min. 32 caracteres).
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-esta-chave-em-producao"

# Credenciais do primeiro administrador criado pelo seed
ADMIN_EMAIL="admin@empresa.com"
ADMIN_SENHA="admin123"
