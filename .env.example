# Postgres (Supabase, Neon, Railway ou local)
DATABASE_URL="postgresql://usuario:senha@host:5432/ponto?schema=public"

# Chave usada para assinar o cookie de sessao (min. 32 caracteres).
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-esta-chave-em-producao"

# ---------------------------------------------------------------------------
# Abaixo: valores aplicados por `npm run db:seed`.
# Tudo aqui tambem pode ser ajustado depois pela tela de Configuracoes.
# ---------------------------------------------------------------------------

# Credenciais do primeiro administrador
ADMIN_EMAIL="admin@empresa.com"
ADMIN_SENHA="admin123"

# Identificacao da empresa
EMPRESA_NOME="Minha Empresa"
EMPRESA_FUSO="America/Sao_Paulo"

# Cerca virtual: coordenadas do local de trabalho.
# Para descobrir: abra o Google Maps, clique com o botao direito sobre o ponto
# exato da loja e clique nos numeros que aparecem no topo do menu (isso copia
# "latitude, longitude"). Preencher as duas ja liga a cerca virtual.
EMPRESA_LATITUDE=""
EMPRESA_LONGITUDE=""

# Raio aceito ao redor do ponto acima, em metros.
EMPRESA_RAIO_METROS="200"

# "true" impede o registro fora do raio; qualquer outro valor apenas sinaliza
# a batida fora do local no painel do administrador.
EMPRESA_GEOFENCE_BLOQUEIA="false"
